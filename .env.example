# Development: copy to .env.local and supply your Resend API key.
# Start with: php -S 127.0.0.1:3002 contact.php
# Both environments use the verified KledPOS sender.
# Resend requires an API key in BOTH environments.
APP_ENV=development
RESEND_API_KEY=
RESEND_TO_EMAIL=contact@kledpos.com
RESEND_FROM_EMAIL=KledPOS <noreply@kledpos.com>

# Production: set these in the server environment (not in .env.local).
# APP_ENV=production
# RESEND_API_KEY=your_production_api_key
# RESEND_FROM_EMAIL=KledPOS <noreply@kledpos.com>
# RESEND_TO_EMAIL=contact@kledpos.com
# The production sender's domain must be verified in the same Resend account.
